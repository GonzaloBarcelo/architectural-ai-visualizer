# González Cardona · Architectural AI Visualizer — container settings.
# Copy to .env and fill in OPENAI_API_KEY. Never commit .env (it is ignored by Git and Docker).
# Used by: docker run --env-file .env …   or   docker compose up

# --- OpenAI access ----------------------------------------------------------------------------
OPENAI_API_KEY=

# --- AI models used by the app (all calls go to the OpenAI API) -------------------------------
# 1. PDF plan reading: walls/openings, furniture and cross-check review (3 calls, high reasoning).
OPENAI_PLAN_MODEL=gpt-5.4
# 2. DWG/DXF doubts: one call for what the drawing leaves open (medium reasoning).
OPENAI_DWG_MODEL=gpt-5.4
# 3. Client materials description → render finishes (low reasoning).
OPENAI_MATERIALS_MODEL=gpt-5.4
# 4. AI enhancement of the finished renders (image edits).
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high
# 5. CLI-only `python -m pipelines.run --vision` proposals (not used by the web app).
OPENAI_VISION_MODEL=gpt-4.1
# Optional shared fallback for 1–3 and 5 when their own setting is empty.
# OPENAI_MODEL=gpt-5.4

# --- AI enhancement of the renders ------------------------------------------------------------
# 0 turns the step off for the whole server (originals are always delivered).
AAV_ENHANCE=1
AAV_ENHANCE_AXONOMETRIC=1

# --- DWG reading ------------------------------------------------------------------------------
# 1 attaches a labelled low-resolution plan image to the DWG doubts call.
AAV_DWG_IMAGE=1

# --- Render quality ---------------------------------------------------------------------------
# The container renders on the CPU (no Metal GPU, emulated x86-64 on Apple Silicon). Measured on
# this Mac: 800 px / 32 samples ≈ 3 min for the 6 views. Time grows with pixels × samples:
#   1200 / 64  ≈ 13 min per project (container default)
#   1600 / 160 ≈ 60 min per project (native app quality)
AAV_RENDER_RESOLUTION=1200
AAV_RENDER_SAMPLES=64
